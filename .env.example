# ════════════════════════════════════════════════════════════════════════════
# Manufacturing Quality Control Agent — Environment Variables
# Copy this file to .env and fill in your values.
# ════════════════════════════════════════════════════════════════════════════

# ── Google Gemini (required for AI-generated explanations) ───────────────────
# 1. Go to: https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Copy the key — it will start with "AIza" and be ~39 characters long
# 4. Paste it below, replacing everything after the = sign
GEMINI_API_KEY=AIzaYOUR_REAL_KEY_HERE

# ── Gemini model to use ───────────────────────────────────────────────────────
# Recommended free-tier models: gemini-1.5-flash  or  gemini-2.0-flash
GEMINI_MODEL_ID=gemini-1.5-flash

# ── Application settings ─────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
